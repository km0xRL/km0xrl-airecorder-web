# --- Владелец ---
# Для локальной разработки достаточно пароля. На сервере используйте хеш:
#   pnpm hash-password 'ваш-пароль'
OWNER_PASSWORD=change-me
# OWNER_PASSWORD_HASH=scrypt\$16384\$8\$1\$...

# --- Секреты ---
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
# Токен для Android/Mac, заголовок Authorization: Bearer <INGEST_TOKEN>
INGEST_TOKEN=change-me-too

# --- Адрес и хранилище ---
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
MAX_AUDIO_BYTES=524288000
NEXT_PUBLIC_APP_TIMEZONE=Europe/Moscow
# Только для локальной проверки production-сборки по HTTP:
# COOKIE_SECURE=false
